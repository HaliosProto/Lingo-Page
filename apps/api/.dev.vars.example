# Copy to apps/api/.dev.vars for local provider testing. The copied file is ignored.
# Configure only providers you intend to use. Never place these values in WXT variables.
ENVIRONMENT=development
TRANSLATION_ENABLED=true
TRANSLATION_DEFAULT_PROVIDER=mock
ENABLED_PROVIDERS=auto
DISABLED_PROVIDERS=
DEV_AUTH_TOKEN=

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
GEMINI_ALLOWED_MODELS=

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_ALLOWED_MODELS=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_ALLOWED_MODELS=

DEEPL_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=
DEEPSEEK_ALLOWED_MODELS=

MOONSHOT_API_KEY=
KIMI_DEFAULT_MODEL=
KIMI_ALLOWED_MODELS=

ZAI_API_KEY=
GLM_DEFAULT_MODEL=
GLM_ALLOWED_MODELS=

DASHSCOPE_API_KEY=
QWEN_DEFAULT_MODEL=
QWEN_ALLOWED_MODELS=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

XAI_API_KEY=
XAI_DEFAULT_MODEL=
XAI_ALLOWED_MODELS=

MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=
MISTRAL_ALLOWED_MODELS=

MINIMAX_API_KEY=
MINIMAX_DEFAULT_MODEL=
MINIMAX_ALLOWED_MODELS=

COHERE_API_KEY=
COHERE_DEFAULT_MODEL=
COHERE_ALLOWED_MODELS=

CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_DEFAULT_MODEL=
CUSTOM_OPENAI_ALLOWED_MODELS=
CUSTOM_OPENAI_CAPABILITIES=json-object,cancellation,usage

MAX_SEGMENTS_PER_REQUEST=500
MAX_INPUT_CHARACTERS_PER_REQUEST=20000
MAX_OUTPUT_CHARACTERS_PER_REQUEST=60000
MAX_OUTPUT_TOKENS=8000
MAX_CONCURRENT_PROVIDER_REQUESTS=4
PROVIDER_TIMEOUT_MS=20000
PROVIDER_MAX_RETRIES=1
PROVIDER_CHARACTER_QUOTAS=
MODEL_DISCOVERY_CACHE_SECONDS=3600
REQUESTS_PER_MINUTE=30
CHARACTERS_PER_SESSION=200000
