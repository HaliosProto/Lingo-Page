{
  "name": "@translation/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt dev -b chrome",
    "build": "wxt build -b chrome",
    "build:e2e": "wxt build -b chrome --mode e2e",
    "typecheck": "wxt prepare && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@translation/shared-config": "workspace:*",
    "@translation/shared-types": "workspace:*",
    "@translation/shared-validation": "workspace:*",
    "@translation/translation-core": "workspace:*",
    "@translation/ui": "workspace:*",
    "@wxt-dev/module-react": "1.2.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "wxt": "0.20.27"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
