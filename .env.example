# Client-safe configuration. WXT exposes variables prefixed with WXT_ to the extension bundle.
WXT_API_BASE_URL=http://localhost:8787

# Backend-only development configuration. Never expose these values to the extension.
ENVIRONMENT=development
APP_VERSION=0.1.0
ALLOWED_EXTENSION_IDS=
TRANSLATION_ENABLED=false
DEV_AUTH_TOKEN=replace-with-a-local-only-random-token
DEEPL_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Future account and usage infrastructure; not used in Milestone 0 or 1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Operational safety defaults. Production values belong in platform secrets/config.
MAX_SEGMENTS_PER_REQUEST=500
MAX_INPUT_CHARACTERS_PER_REQUEST=20000
MAX_OUTPUT_CHARACTERS_PER_REQUEST=60000
PER_USER_REQUESTS_PER_MINUTE=30
PER_IP_REQUESTS_PER_MINUTE=60
